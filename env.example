# Copy this file to ".env" and fill in your key. Never commit the real .env.
ANTHROPIC_API_KEY=sk-ant-...

# OPTIONAL. Leave blank and VOLT still knows the real library: the browser
# posts a snapshot of the catalogue it already loaded under the visitor's own
# session, and the server indexes that.
#
# Set it if you'd rather the server read Supabase itself — more robust (works
# even if a client sends nothing) and not client-controlled. The `documents`
# table is RLS-gated, so the publishable/anon key returns an empty list; use a
# service_role key (Supabase dashboard -> Project Settings -> API). Server-side
# only — it must never appear in the front-end bundle or in git.
SUPABASE_URL=https://mizlazbsufftjtlvdrjv.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional overrides:
# CATALOGUE_TTL_MS=300000         # how long to cache the catalogue (default 5 min)
# CHAT_MODEL=claude-opus-4-8      # default. Cheaper options: claude-haiku-4-5, claude-sonnet-4-6
# PORT=3000
